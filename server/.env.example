# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/watchbox?retryWrites=true&w=majority

# Session Secret (Minimum 32 characters random string)
SESSION_SECRET=your_long_session_secret_change_in_production

# TMDB API Credentials (Exclusively backend)
TMDB_API_KEY=your_tmdb_api_key_or_token
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Client Origin (CORS and cookie trust)
CLIENT_ORIGIN=http://localhost:5173
